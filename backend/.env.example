DATABASE_URL="postgresql://crm_user:crm_password@localhost:5432/avito_crm?schema=public"
JWT_SECRET="change_me_to_a_long_random_string"
PORT=4000

# Публичный HTTPS-адрес вашего backend, куда Авито будет слать вебхуки.
# Обязательно должен быть доступен из интернета (не localhost!) на проде.
# Пример: https://crm.mycompany.ru
PUBLIC_BASE_URL="https://your-domain.example.com"

# Значения по умолчанию можно не задавать здесь -
# каждый аккаунт Авито подключается через UI (Настройки -> Аккаунты Авито)
# и его client_id/client_secret хранятся в базе, а не в .env.
